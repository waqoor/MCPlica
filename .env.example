# MCPlica core
MCP_LICA_ENV=development
MCP_LICA_LOG_LEVEL=INFO
MCP_LICA_API_HOST=0.0.0.0
MCP_LICA_API_PORT=8000
MCP_LICA_FRONTEND_PORT=8080
MCP_LICA_EDGE_PORT=80
MCP_LICA_EDGE_TLS_PORT=8443
MCP_LICA_API_DOMAIN=api.localhost
MCP_LICA_FRONTEND_ORIGIN=http://localhost:8080
MCP_LICA_METRICS_BEARER_TOKEN=
MCP_LICA_READINESS_TIMEOUT_SECONDS=5

# PostgreSQL
MCP_LICA_POSTGRES_PASSWORD=
MCP_LICA_DATABASE_URL=postgresql+psycopg://mcplica:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/mcplica

# Redis
MCP_LICA_REDIS_URL=redis://redis:6379/0
MCP_LICA_BUILD_QUEUE_NAME=mcplica-builds
MCP_LICA_DEPLOYMENT_QUEUE_NAME=mcplica-deployments

# Milvus object storage (internal MinIO; use separate random values)
MCP_LICA_MINIO_ROOT_USER=
MCP_LICA_MINIO_ROOT_PASSWORD=

# Milvus - builder only
MCP_LICA_MILVUS_URI=http://milvus:19530
MCP_LICA_MILVUS_TOKEN=
MCP_LICA_MILVUS_COLLECTION=mcplica_document_chunks

# OpenRouter - builder/review only; never passed to generated MCP runtimes
MCP_LICA_OPENROUTER_API_KEY=
MCP_LICA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MCP_LICA_OPENROUTER_ANALYSIS_MODEL=
MCP_LICA_OPENROUTER_VALIDATION_MODEL=
MCP_LICA_OPENROUTER_EMBEDDING_MODEL=
MCP_LICA_OPENROUTER_SITE_URL=
MCP_LICA_OPENROUTER_APP_NAME=MCPlica
MCP_LICA_OPENROUTER_MAX_ATTEMPTS=3
MCP_LICA_OPENROUTER_STRUCTURED_MAX_ATTEMPTS=2
MCP_LICA_OPENROUTER_MAX_CONCURRENCY=4
MCP_LICA_OPENROUTER_MAX_CONTEXT_CHARS=120000
MCP_LICA_SEMANTIC_RETRIEVAL_TOP_K=5

# Control-plane secret encryption (URL-safe base64 encoded 32-byte AES-256-GCM key)
MCP_LICA_SECRET_ENCRYPTION_KEY=
MCP_LICA_SECRET_ENCRYPTION_KEY_VERSION=v1
# Independent high-entropy values; never reuse the encryption key.
MCP_LICA_AUTH_SIGNING_KEY=
MCP_LICA_REFRESH_TOKEN_PEPPER=
# Required only while bootstrapping the first administrator; remove afterwards.
MCP_LICA_BOOTSTRAP_SECRET=

# Local artifact storage
MCP_LICA_ARTIFACT_ROOT=/data/artifacts
MCP_LICA_FETCH_MAX_ATTEMPTS=3
MCP_LICA_DOCUMENT_PARSE_MAX_CONCURRENCY=4

# Docker / deployment
MCP_LICA_DOCKER_BASE_URL=unix:///var/run/docker.sock
MCP_LICA_MCP_RUNTIME_IMAGE=mcplica/mcp-runtime:1.0.0
MCP_LICA_MCP_RUNTIME_VERSION=1.0.0
MCP_LICA_MCP_RUNTIME_PULL_POLICY=missing
MCP_LICA_MCP_DOMAIN=mcp.localhost
MCP_LICA_TRAEFIK_NETWORK=mcplica-edge
MCP_LICA_TRAEFIK_CONTAINER_NAME=mcplica-traefik-1
MCP_LICA_TRAEFIK_ENTRYPOINT=web
MCP_LICA_TRAEFIK_TLS=false
MCP_LICA_TRAEFIK_CERT_RESOLVER=
MCP_LICA_RUNTIME_HOST_ROOT=/var/lib/mcplica/runtime
MCP_LICA_RUNTIME_WORKER_ROOT=/runtime-host
MCP_LICA_RUNTIME_UID=10001
MCP_LICA_RUNTIME_GID=10001
MCP_LICA_DOCKER_GID=0
MCP_LICA_RUNTIME_MANIFEST_MAX_BYTES=10000000
MCP_LICA_RUNTIME_SECRET_BUNDLE_MAX_BYTES=1000000
MCP_LICA_RUNTIME_MEMORY_BYTES=536870912
MCP_LICA_RUNTIME_NANO_CPUS=1000000000
MCP_LICA_RUNTIME_PIDS_LIMIT=256
MCP_LICA_RUNTIME_TMPFS_BYTES=67108864

# Production Compose override (required only with infra/compose.production.yaml)
MCP_LICA_UI_DOMAIN=
MCP_LICA_ACME_EMAIL=
MCP_LICA_BACKEND_IMAGE=
MCP_LICA_FRONTEND_IMAGE=

# Runtime example configuration. Deployment normally supplies these values and a
# per-project read-only secret bundle; do not place upstream credentials here.
MCP_ENVIRONMENT=development
MCP_RUNTIME_VERSION=1.0.0
MCP_MANIFEST_PATH=/runtime/manifest.json
MCP_MANIFEST_SHA256=
MCP_SECRET_BUNDLE_PATH=/run/secrets/mcplica-runtime.json
MCP_RUNTIME_HOST=0.0.0.0
MCP_RUNTIME_PORT=8000
MCP_PUBLIC_BASE_URL=http://localhost:9000
MCP_ALLOWED_HOSTS=localhost,localhost:9000,127.0.0.1,127.0.0.1:9000
MCP_ALLOWED_ORIGINS=
MCP_TLS_VERIFY=true
MCP_TRUST_ENVIRONMENT_PROXY=false
MCP_REQUIRE_SECURE_SECRET_PERMISSIONS=true
