# MCPlica core
MCP_LICA_ENV=development
MCP_LICA_LOG_LEVEL=INFO
MCP_LICA_API_HOST=0.0.0.0
MCP_LICA_API_PORT=8000
MCP_LICA_FRONTEND_ORIGIN=http://localhost:8080

# PostgreSQL
MCP_LICA_DATABASE_URL=postgresql+asyncpg://mcplica:mcplica@postgres:5432/mcplica

# Redis
MCP_LICA_REDIS_URL=redis://redis:6379/0
MCP_LICA_RQ_QUEUE=mcplica

# Milvus - builder only
MCP_LICA_MILVUS_URI=http://milvus:19530
MCP_LICA_MILVUS_TOKEN=
MCP_LICA_MILVUS_COLLECTION=mcplica_document_chunks

# OpenRouter - builder/review only; never passed to generated MCP runtimes
MCP_LICA_OPENROUTER_API_KEY=
MCP_LICA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MCP_LICA_OPENROUTER_MODEL=
MCP_LICA_OPENROUTER_SITE_URL=
MCP_LICA_OPENROUTER_APP_NAME=MCPlica

# Control-plane secret encryption (Fernet URL-safe base64 key)
MCP_LICA_SECRET_ENCRYPTION_KEY=

# Local artifact storage
MCP_LICA_ARTIFACT_ROOT=/data/artifacts

# Docker / deployment
MCP_LICA_DOCKER_BASE_URL=unix:///var/run/docker.sock
MCP_LICA_MCP_RUNTIME_IMAGE=mcplica/mcp-runtime:dev
MCP_LICA_MCP_DOMAIN=mcp.localhost
MCP_LICA_TRAEFIK_NETWORK=mcplica-edge

# Runtime example configuration (used by mcp_runtime container, not builder)
MCP_MANIFEST_PATH=/runtime/manifest.json
MCP_RUNTIME_HOST=0.0.0.0
MCP_RUNTIME_PORT=8000
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
MCP_ALLOWED_ORIGINS=
MCP_INBOUND_BEARER_TOKEN=
MCP_UPSTREAM_BEARER_TOKEN=
MCP_UPSTREAM_API_KEY=
MCP_UPSTREAM_BASIC_USERNAME=
MCP_UPSTREAM_BASIC_PASSWORD=
