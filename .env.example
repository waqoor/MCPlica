# MCPlica core
ENV=development
MCPLICA_VERSION=1.0.0-rc.1
# Compose project identity. Use a unique value for side-by-side disposable validation.
COMPOSE_PROJECT_NAME=mcplica
# Resolved relative to infra/compose.yaml for backend service env_file loading.
CONTROL_PLANE_ENV_FILE=../.env
# Local builds use this OCI revision label. Release automation supplies the commit SHA.
MCPLICA_VCS_REF=local
# Populated only in generated development environments by scripts/init_env.py.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8080
EDGE_PORT=80
EDGE_TLS_PORT=8443
API_DOMAIN=api.localhost
FRONTEND_ORIGIN=http://localhost:8080
METRICS_BEARER_TOKEN=
READINESS_TIMEOUT_SECONDS=5

# PostgreSQL
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://mcplica:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/mcplica
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=4
SHUTDOWN_TIMEOUT_SECONDS=15
BUILD_QUEUE_NAME=mcplica-builds
DEPLOYMENT_QUEUE_NAME=mcplica-deployments
BUILD_JOB_TIMEOUT_SECONDS=3600
BUILD_JOB_MAX_ATTEMPTS=3
BUILD_CONCURRENCY=2
BUILDERS_CAN_DEPLOY=false
BUILD_ADMISSION_DISPATCH_INTERVAL_SECONDS=1
BUILD_ADMISSION_LEASE_SECONDS=300
BUILD_ADMISSION_HEARTBEAT_SECONDS=30
RUNTIME_COMMAND_DISPATCH_INTERVAL_SECONDS=1
RUNTIME_COMMAND_DISPATCH_LEASE_SECONDS=30
RUNTIME_COMMAND_EXECUTION_LEASE_SECONDS=1200
RUNTIME_COMMAND_EXECUTION_HEARTBEAT_SECONDS=30
RUNTIME_ROUTE_RECONCILE_INTERVAL_SECONDS=15
DEPLOYMENT_JOB_TIMEOUT_SECONDS=900
DEPLOYMENT_JOB_MAX_ATTEMPTS=3
CLEANUP_DISPATCH_INTERVAL_SECONDS=5
CLEANUP_LEASE_SECONDS=60
CLEANUP_MAX_ATTEMPTS=8
CLEANUP_RETENTION_INTERVAL_SECONDS=3600
CLEANUP_ORPHAN_GUARD_DELAY_SECONDS=300

# Milvus object storage (internal MinIO; use separate random values)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Milvus - builder only
MILVUS_URI=http://milvus:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=mcplica_document_chunks
MILVUS_MEMORY_LIMIT=8g

# OpenRouter - builder/review only; never passed to generated MCP runtimes
OPENROUTER_API_KEY=
# HTTP API root used to build /models, /chat/completions, and /embeddings requests.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_VALIDATION_MODEL=
OPENROUTER_EMBEDDING_MODEL=
# Optional app URL sent as HTTP-Referer attribution; it is not an API endpoint.
OPENROUTER_SITE_URL=
# App label sent as OpenRouter attribution metadata.
OPENROUTER_APP_NAME=MCPlica
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_ATTEMPTS=3
OPENROUTER_STRUCTURED_MAX_ATTEMPTS=2
OPENROUTER_MAX_CONCURRENCY=4
OPENROUTER_MAX_CONTEXT_CHARS=120000
SEMANTIC_RETRIEVAL_TOP_K=5

# Control-plane secret encryption (URL-safe base64 encoded 32-byte AES-256-GCM key)
SECRET_ENCRYPTION_KEY=
SECRET_ENCRYPTION_KEY_VERSION=v1
SECRET_ENCRYPTION_PREVIOUS_KEYS={}
# Independent high-entropy values; never reuse the encryption key.
AUTH_SIGNING_KEY=
REFRESH_TOKEN_PEPPER=
# Required only while bootstrapping the first administrator; remove afterwards.
BOOTSTRAP_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=mcplica_access
REFRESH_COOKIE_NAME=mcplica_refresh
CSRF_COOKIE_NAME=mcplica_csrf
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Local artifact storage
ARTIFACT_ROOT=/data/artifacts
UPLOAD_MAX_BYTES=100000000
MULTIPART_SPOOL_CAPACITY_BYTES=220000000
DOCUMENT_MAX_BYTES=100000000
DOCUMENT_MAX_TEXT_CHARS=5000000
FETCH_MAX_ATTEMPTS=3
FETCH_MAX_BYTES=25000000
FETCH_MAX_REDIRECTS=3
FETCH_TIMEOUT_SECONDS=30
ALLOW_HTTP_SOURCE_URLS=false
SOURCE_ALLOWED_HOSTS=
SOURCE_ALLOWED_PRIVATE_CIDRS=
DOCUMENTATION_CHUNK_CHARS=6000
DOCUMENTATION_CHUNK_OVERLAP_CHARS=500
DOCUMENTATION_MAX_CHUNKS_PER_PROJECT=10000
DOCUMENT_PARSE_MAX_CONCURRENCY=4
PDF_MAX_PAGES=500
EMBEDDING_BATCH_SIZE=64
BUILD_ARTIFACT_MAX_BYTES=100000000
MAX_OPERATIONS_PER_PROJECT=1000
SOURCE_RETENTION_DAYS=
BUILD_RETENTION_COUNT=20

# Docker / deployment
DOCKER_BASE_URL=unix:///var/run/docker.sock
MCP_RUNTIME_IMAGE=mcplica-runtime:local
MCP_RUNTIME_PULL_POLICY=missing
MCP_DOMAIN=mcp.localhost
BUILDER_NETWORK=mcplica-builder
EGRESS_NETWORK=mcplica-egress
TRAEFIK_NETWORK=mcplica-edge
TRAEFIK_CONTAINER_NAME=mcplica-traefik-1
TRAEFIK_ENTRYPOINT=web
TRAEFIK_TLS=false
TRAEFIK_CERT_RESOLVER=
RUNTIME_HOST_ROOT=/var/lib/mcplica/runtime
RUNTIME_WORKER_ROOT=/runtime-host
RUNTIME_UID=10001
RUNTIME_GID=10001
# On Linux: set to `stat -c %g /var/run/docker.sock`.
DOCKER_GID=0
# Keep deployment-worker and generated runtime ownership aligned.
WORKER_STOP_GRACE_PERIOD=30s
# Docker logs are bounded independently of application event formatting.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
MCP_RUNTIME_VALIDATOR_URL=http://runtime-validator:8090/validate
MCP_RUNTIME_VALIDATOR_TIMEOUT_SECONDS=60
RUNTIME_MANIFEST_MAX_BYTES=10000000
RUNTIME_SECRET_BUNDLE_MAX_BYTES=1000000
RUNTIME_UPSTREAM_TIMEOUT_MS=30000
RUNTIME_MAX_REQUEST_BYTES=10000000
RUNTIME_MAX_RESPONSE_BYTES=2000000
RUNTIME_MEMORY_BYTES=536870912
RUNTIME_NANO_CPUS=1000000000
RUNTIME_PIDS_LIMIT=256
RUNTIME_TMPFS_BYTES=67108864
RUNTIME_STOP_TIMEOUT_SECONDS=15
RUNTIME_HEALTH_TIMEOUT_SECONDS=90
RUNTIME_HEALTH_POLL_SECONDS=1
RUNTIME_ALLOWED_PRIVATE_HOSTS=
RUNTIME_ALLOWED_DEVELOPMENT_HOSTS=

# Production Compose override (required only with infra/compose.production.yaml)
UI_DOMAIN=
ACME_EMAIL=
BACKEND_IMAGE=mcplica-api:local
FRONTEND_IMAGE=mcplica-frontend:local

# Runtime example configuration. Deployment normally supplies these values and a
# per-project read-only secret bundle; do not place upstream credentials here.
MCP_ENVIRONMENT=development
# MCP_RUNTIME_VERSION is derived from MCPLICA_VERSION by Compose/deployment.
MCP_DEPLOYMENT_ID=
MCP_MANIFEST_PATH=/runtime/manifest.json
MCP_MANIFEST_SHA256=
MCP_AUTH_OVERLAY_SHA256=
MCP_SECRET_BUNDLE_PATH=/run/secrets/mcplica-runtime.json
MCP_RUNTIME_HOST=0.0.0.0
MCP_RUNTIME_PORT=8000
MCP_PUBLIC_BASE_URL=http://localhost:9000
MCP_ALLOWED_HOSTS=localhost,localhost:9000,127.0.0.1,127.0.0.1:9000
MCP_ALLOWED_ORIGINS=
MCP_MAX_MANIFEST_BYTES=10000000
MCP_MAX_SECRET_BUNDLE_BYTES=1000000
MCP_MAX_MCP_REQUEST_BYTES=2000000
MCP_MAX_UPSTREAM_REQUEST_BYTES=10000000
MCP_HTTP_MAX_CONNECTIONS=100
MCP_HTTP_MAX_KEEPALIVE_CONNECTIONS=20
MCP_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
MCP_HTTP_CONNECT_TIMEOUT_SECONDS=10
MCP_HTTP_READ_TIMEOUT_SECONDS=30
MCP_HTTP_WRITE_TIMEOUT_SECONDS=30
MCP_HTTP_POOL_TIMEOUT_SECONDS=10
MCP_TLS_VERIFY=true
MCP_TRUST_ENVIRONMENT_PROXY=false
MCP_REQUIRE_SECURE_SECRET_PERMISSIONS=true
MCP_LOG_LEVEL=INFO
