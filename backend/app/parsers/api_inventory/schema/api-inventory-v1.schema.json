{
  "$defs": {
    "HttpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ],
      "title": "HttpMethod",
      "type": "string"
    },
    "InventoryOperation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "method": {
          "$ref": "#/$defs/HttpMethod"
        },
        "operation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/InventoryParameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "path": {
          "pattern": "^/",
          "title": "Path",
          "type": "string"
        },
        "request_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/InventoryRequestBody"
            },
            {
              "type": "null"
            }
          ],
          "default": null
